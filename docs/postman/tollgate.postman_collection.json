{
  "info": {
    "_postman_id": "9a61acf2-45a4-443a-b298-d2c889e5860a",
    "name": "Tollgate API",
    "description": "Pay-per-request for AI agents, settled through PayPal.\n\nRun the folders top to bottom. **Account \u2192 Sign up** saves a session token; **Live demo** creates a Research Agent and two sellers, starts a PayPal sandbox top-up, runs the agent and approves its $0.50 purchase.\n\nSet `baseUrl` to your hub (default: the live demo). Amounts in JSON are integer micros (1 USD = 1,000,000) unless the field ends in `Usd`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{sessionToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// A fresh email per run, so Sign up always works.",
          "if (!pm.collectionVariables.get('email')) pm.collectionVariables.set('email', `postman-${Date.now()}@example.com`);"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://usetollgate.onrender.com"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": "postman-demo-123"
    },
    {
      "key": "sessionToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "agentId",
      "value": ""
    },
    {
      "key": "agentKey",
      "value": ""
    },
    {
      "key": "sellerId",
      "value": ""
    },
    {
      "key": "approvalId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"reports PayPal mode\", () => pm.expect(pm.response.json()).to.have.property(\"paypalMode\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Receipt keys (for sellers)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/.well-known/tollgate.json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ".well-known",
                "tollgate.json"
              ]
            },
            "description": "The hub's Ed25519 public keys. Sellers use them to verify receipts offline.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"has a key\", () => pm.expect(pm.response.json().keys.length).to.be.above(0));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Account",
      "item": [
        {
          "name": "Sign up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"sessionToken\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"sessionToken\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Live demo",
      "item": [
        {
          "name": "Start the live demo",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/demo/setup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "demo",
                "setup"
              ]
            },
            "description": "Creates a Research Agent (rules: $2/day, max $1, ask above $0.25, only atlas.demo) and two sellers: Atlas Data and QuickLeads."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"agentId\", pm.response.json().agentId);",
                  "pm.collectionVariables.set(\"sellerId\", pm.response.json().atlasSellerId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Demo status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/demo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "demo"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Top up $10 with PayPal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/agents/{{agentId}}/topups",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "agents",
                "{{agentId}}",
                "topups"
              ]
            },
            "description": "Returns `approveUrl`. Open it in a browser and pay with a PayPal sandbox Personal account; the wallet is credited when PayPal sends you back.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amountUsd\": \"10.00\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "console.log(\"Open this to pay:\", pm.response.json().approveUrl);"
                ]
              }
            }
          ]
        },
        {
          "name": "Run the agent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/demo/run",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "demo",
                "run"
              ]
            },
            "description": "Runs the Claude research agent on the hub. Progress arrives as agent.* events on /api/events.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task\": \"Who's leading the Formula 1 championship right now?\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 202\", () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "Pending approvals",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/approvals?status=pending",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "approvals"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "pending"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const first = pm.response.json().approvals[0];",
                  "if (first) pm.collectionVariables.set(\"approvalId\", first.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Approve the purchase",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/approvals/{{approvalId}}/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "approvals",
                "{{approvalId}}",
                "approve"
              ]
            },
            "description": "Approves the payment the agent is waiting on. If nothing is waiting yet (the wallet isn't funded or the agent hasn't reached the $0.50 report), this returns 404."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"approved, or nothing waiting yet\", () => pm.expect([200, 404]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Overview (wallets, sellers, audit)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/overview",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "overview"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"ledger balances\", () => pm.expect(pm.response.json().audit.ok).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cash out the seller (PayPal Payouts)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sellers/{{sellerId}}/payouts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sellers",
                "{{sellerId}}",
                "payouts"
              ]
            },
            "description": "Needs a PayPal email on the seller and at least the hub's minimum payout.",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"created or refused with a reason\", () => pm.expect([201, 400, 409, 422]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Payouts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/payouts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payouts"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Your own agents and sellers",
      "item": [
        {
          "name": "Create an agent wallet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/agents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "agents"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman agent\",\n  \"policy\": {\n    \"dailyLimitUsd\": \"5.00\",\n    \"maxPerRequestUsd\": \"1.00\",\n    \"approvalAboveUsd\": \"0.25\",\n    \"allowedHosts\": [\n      \"api.example.com\"\n    ]\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"agentKey\", pm.response.json().apiKey);"
                ]
              }
            }
          ]
        },
        {
          "name": "Wallet (as the agent)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/wallet",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "wallet"
              ]
            },
            "description": "Uses the agent's API key, not your session.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{agentKey}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register a seller",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sellers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sellers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman API\",\n  \"paypalEmail\": \"seller@example.com\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ledger transactions for an account",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/overview",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "overview"
              ]
            },
            "description": "Pick an accountId from the overview, then call /api/ledger/txns?accountId=\u2026"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Hub admin",
      "item": [
        {
          "name": "Ledger audit",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ledger/audit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ledger",
                "audit"
              ]
            },
            "description": "Needs the hub's HUB_ADMIN_TOKEN in the adminToken variable.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
