{
  "name": "tollgate",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source pay-per-request for AI agents, settled through PayPal.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check-setup": "node --import tsx scripts/check-setup.ts",
    "hub": "npm run dev -w @tollgate/hub",
    "try": "node --disable-warning=ExperimentalWarning --import tsx scripts/try.ts",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test \"packages/*/test/*.test.ts\" \"apps/*/test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
