# Copy this file to ".env" and fill in the values. Never commit .env.

# ── PayPal sandbox ─────────────────────────────────────────────
# developer.paypal.com → Apps & Credentials → Sandbox → your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Leave empty to use real PayPal sandbox. "mock" simulates PayPal offline.
PAYPAL_MODE=

# Sandbox account email that receives the demo seller's payouts
# (Testing Tools → Sandbox Accounts, use the US Personal account)
DEMO_SELLER_PAYPAL_EMAIL=

# ── Claude ─────────────────────────────────────────────────────
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Any current Claude model ID. "npm run check-setup" lists the ones your key can use.
CLAUDE_MODEL=

# ── Tollgate hub ───────────────────────────────────────────────
HUB_PORT=4000
# Where agents, sellers and PayPal reach the hub (on Render it defaults to the service URL)
HUB_URL=http://localhost:4000
# Password for admin actions (top-ups, payouts, dashboard)
HUB_ADMIN_TOKEN=change-me
# Platform fee on each paid request, in basis points (100 = 1%)
TOLLGATE_FEE_BPS=100
# Optional: private key (JWK JSON) for signing receipts. Create one with
# "npm run signing-key". If empty, one is generated and kept in the database.
HUB_SIGNING_KEY=
# Optional: where the ledger database lives (default: data/tollgate.db)
DB_PATH=
# Anyone can create an account on the website. Set to false to turn sign-ups off.
ALLOW_SIGNUPS=true
# Smallest amount a seller can cash out, in USD
MIN_PAYOUT_USD=1.00

# ── Hosted demo (Research Agent that runs on the hub) ──────────
# Uses ANTHROPIC_API_KEY and CLAUDE_MODEL above. After this many Claude runs per
# day (and 5 per user), runs switch to a scripted replay. Payments stay real.
DEMO_CLAUDE_RUNS_PER_DAY=30
# Optional sandbox Personal login shown in the demo so visitors can finish
# the PayPal sandbox checkout. Sandbox only, never a real account.
DEMO_PAYPAL_BUYER_EMAIL=
DEMO_PAYPAL_BUYER_PASSWORD=

# ── Demo paid API ──────────────────────────────────────────────
DEMO_API_PORT=4100
DEMO_API_URL=http://localhost:4100
