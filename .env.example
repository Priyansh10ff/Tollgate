# Copy this file to ".env" and fill in the values. Never commit .env.

# ── PayPal sandbox ─────────────────────────────────────────────
# developer.paypal.com → Apps & Credentials → Sandbox → your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# ── Claude ─────────────────────────────────────────────────────
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Any current Claude model ID from https://docs.claude.com/en/docs/about-claude/models
CLAUDE_MODEL=

# ── Tollgate hub ───────────────────────────────────────────────
HUB_PORT=4000
# Where agents, sellers and PayPal reach the hub (change when deployed)
HUB_URL=http://localhost:4000
# Password for the dashboard's admin actions (approve, payout)
HUB_ADMIN_TOKEN=change-me

# ── Demo paid API ──────────────────────────────────────────────
DEMO_API_PORT=4100
DEMO_API_URL=http://localhost:4100
